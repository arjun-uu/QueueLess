{
  
  "FrontendUrl": "http://localhost:5173",

  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext"
    ],
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/queueless-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "fileSizeLimitBytes": 10485760,
          "rollOnFileSizeLimit": true,
          "shared": true
        }
      }
    ]
  },

  "EmailSettings": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "Username": "arjunuit22@gmail.com",
    "Password": "fqrk qwes xipe zaen",
    "From": "arjunuit22@gmail.com"
  },
  
    "Jwt": {
      "Key": "your-super-secret-key-at-least-32-characters-long",
      "Issuer": "QueueLessAPI",
      "Audience": "QueueLessClient",
      "ExpiryMinutes": 60
    },
 
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "AllowedHosts": "*"
}
